{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://ais-pre-nbpl4ppnqve25n7niidcjo-125836309535.us-west2.run.app/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
