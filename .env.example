# SESSION_SECRET: Cryptographic key for HMAC-SHA256 session token signatures.
# Must be set in Cloud Run and Vercel environment variables.
SESSION_SECRET=

# SITE_PASSWORD: Site access authentication password.
SITE_PASSWORD=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TMDB_API_KEY: The Movie Database API Key for fetching live animation posters, backdrops, and metadata.
# Configured via the Secrets panel in AI Studio Settings.
TMDB_API_KEY=379849c2e59542a503b3bcc3c6d8fcae
VITE_TMDB_API_KEY=379849c2e59542a503b3bcc3c6d8fcae

# OMDB_API_KEY: Open Movie Database API Key (Tertiary fallback tier with 1,000 requests/day limit).
# Configured via Settings or local configuration.
OMDB_API_KEY=aebfb522 

# TMDB_ACCESS_TOKEN: Optional TMDB v4 Read Access Token (Bearer Token).
TMDB_ACCESS_TOKEN=379849c2e59542a503b3bcc3c6d8fcae


# FIREBASE_API_KEY: Optional Firebase API Key for cloud persistence and authentication.
FIREBASE_API_KEY=AIzaSyDASyJIPuvho1GsFpUp7n5PLMdLcqKQrI0 

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

